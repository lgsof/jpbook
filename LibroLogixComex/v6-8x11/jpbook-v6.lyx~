\series default
\emph default
 Un hub logístico en Panamá para distribución en América Latina.
\end_layout

\begin_layout Subsubsection
Almacenes Fiscales o Aduaneros
\end_layout

\begin_layout Itemize
Permiten almacenar productos importados sin nacionalizar hasta que se vendan o cumplan con regulaciones.
\end_layout

\begin_layout Itemize

\series bold
\emph on
